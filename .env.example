# Local Postgres from docker-compose (port 5433 to avoid clashing with a local install)
DATABASE_URL="postgresql://ptw:ptw@localhost:5433/ptw?schema=public"

# Used to sign session JWTs. Any long random string.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Shared secret for the expiry cron endpoint (GET /api/cron/expire with Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="change-me-too"

# Optional: public base URL used in QR codes. Falls back to the request origin.
# APP_URL="https://your-app.vercel.app"
